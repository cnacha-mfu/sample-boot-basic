									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"",
									"// The response is plain text: \"Book created with ID: 11\".",
									"// Grab that id so the update and delete below can use it.",
									"const id = pm.response.text().match(/(\\d+)\\s*$/);",
									"if (id) {",
									"    pm.collectionVariables.set('newBookId', id[1]);",
									"    console.log('new book id = ' + id[1]);",
									"}",
									"",
									"pm.test(\"the database assigned an id\", () => {",
									"    pm.expect(pm.collectionVariables.get('newBookId')).to.not.eql('');",
									"});"
