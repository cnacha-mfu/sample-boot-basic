					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Refactoring\",\n    \"author\": \"Martin Fowler\",\n    \"publish-year\": 2019,\n    \"category\": { \"id\": 1 }\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/books",
							"host": ["{{baseUrl}}"],
							"path": ["books"]
						},
						"description": "Two things to notice.\n\n1. There is no \"id\" in the body. @GeneratedValue(IDENTITY) means MySQL makes it, and Hibernate reads it back.\n\n2. The category is sent as a nested object holding only an id: { \"id\": 1 }. That is a placeholder - the controller loads the real Category row before saving.\n\n3. \"publish-year\" is the JSON name; the field is called year and the column is year. That is @JsonProperty at work."
					},
					"response": []
				},
