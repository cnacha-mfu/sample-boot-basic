								"exec": ["pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Nowhere\",\n    \"author\": \"Nobody\",\n    \"publish-year\": 2000,\n    \"category_id\": 999\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] }
