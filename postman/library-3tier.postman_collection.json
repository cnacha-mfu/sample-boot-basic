		{
			"name": "3. Partial update - the MapStruct lesson",
			"description": "Run these five in order. Steps 2 and 4 send the SAME one-field body; only the method differs.",
			"item": [
				{
					"name": "Step 1 - create a book with every field filled",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"const b = pm.response.json();",
									"pm.collectionVariables.set('patchDemoId', b.id);",
									"pm.test(\"author, year and date are all set\", () => {",
									"    pm.expect(b.author).to.eql('Kent Beck');",
									"    pm.expect(b['publish-year']).to.eql(2002);",
									"    pm.expect(b['added-date']).to.not.be.null;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Before the patch\",\n    \"author\": \"Kent Beck\",\n    \"publish-year\": 2002,\n    \"category_id\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] }
					},
					"response": []
				},
				{
					"name": "Step 2 - PATCH the title only (merge)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test(\"the title changed\", () => pm.expect(b.title).to.eql('After the patch'));",
									"pm.test(\"the author was NOT sent, and survived\", () => {",
									"    pm.expect(b.author).to.eql('Kent Beck');",
									"});",
									"pm.test(\"the year was NOT sent, and survived\", () => {",
									"    pm.expect(b['publish-year']).to.eql(2002);",
									"});",
									"pm.test(\"the date was NOT sent, and survived\", () => {",
									"    pm.expect(b['added-date']).to.not.be.null;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"After the patch\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/books/{{patchDemoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["books", "{{patchDemoId}}"]
						},
						"description": "One field in, everything else untouched.\n\nThe controller LOADS the existing row first, then lets the mapper merge on top. The mapper skips every null field, because of:\n\n    @BeanMapping(nullValuePropertyMappingStrategy = NullValuePropertyMappingStrategy.IGNORE)\n\nLook at BookMapperImpl.java in target/generated-sources and you will see the generated  if (dto.getAuthor() != null)  guards that do it."
					},
					"response": []
				},
				{
					"name": "Step 3 - confirm with a fresh GET",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test(\"really stored, not just echoed back\", () => {",
									"    pm.expect(b.title).to.eql('After the patch');",
									"    pm.expect(b.author).to.eql('Kent Beck');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/books/{{patchDemoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["books", "{{patchDemoId}}"]
						}
					},
					"response": []
				},
				{
					"name": "Step 4 - PUT the SAME body (replace)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"After the put\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/books/{{patchDemoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["books", "{{patchDemoId}}"]
						},
						"description": "Same shape of body as step 2, different verb.\n\nPUT builds a NEW Book and maps onto that, so anything the body left out stays null. PUT means replace - and the next request proves it."
					},
					"response": []
				},
				{
					"name": "Step 5 - the other fields are gone",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test(\"the title changed\", () => pm.expect(b.title).to.eql('After the put'));",
									"pm.test(\"PUT wiped the author it was not given\", () => {",
									"    pm.expect(b.author).to.be.null;",
									"});",
									"pm.test(\"PUT wiped the year too\", () => {",
									"    pm.expect(b['publish-year']).to.be.null;",
									"});",
									"pm.test(\"and the category\", () => {",
									"    pm.expect(b.category_name).to.be.null;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/books/{{patchDemoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["books", "{{patchDemoId}}"]
						},
						"description": "Compare this with step 3. Same one-field body, opposite outcome.\n\nThat is the difference between merge and replace, and it is why an API needs both verbs."
					},
					"response": []
				},
				{
					"name": "Step 6 - clean up",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/books/{{patchDemoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["books", "{{patchDemoId}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Members and borrowing",
			"item": [
				{
					"name": "GET /members/1",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"join-date is renamed by MemberDTO\", () => {",
									"    pm.expect(pm.response.json()).to.have.property('join-date');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/members/1", "host": ["{{baseUrl}}"], "path": ["members", "1"] }
					},
					"response": []
				},
				{
					"name": "PATCH /members/1 - change only the email",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const m = pm.response.json();",
									"pm.test(\"email changed\", () => pm.expect(m.email).to.eql('updated@mfu.ac.th'));",
									"pm.test(\"name survived - same partial update, different entity\", () => {",
									"    pm.expect(m.name).to.eql('Somchai Jaidee');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"updated@mfu.ac.th\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/members/1", "host": ["{{baseUrl}}"], "path": ["members", "1"] },
						"description": "The same MapStruct trick on a second entity, to show it is a pattern and not a one-off."
					},
					"response": []
				},
				{
					"name": "POST /transactions - the design-doc body is back",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"const t = pm.response.json();",
									"pm.test(\"reply names both sides\", () => {",
									"    pm.expect(t.book_title).to.be.a('string');",
									"    pm.expect(t.member_name).to.be.a('string');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"book_id\": 9,\n    \"member_id\": 3,\n    \"type\": \"borrow\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] },
						"description": "{ book_id, member_id, type } - exactly what library-design.md asked for.\n\nIn the JPA sample the entity was the request body, so this had to be sent as a nested { \"book\": { \"id\": 9 } }. TransactionDTO put the wire format back under our control."
					},
					"response": []
				},
				{
					"name": "POST /transactions - already borrowed is 400",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
									"pm.test(\"explains why\", () => {",
									"    pm.expect(pm.response.text()).to.include('already borrowed');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"book_id\": 9,\n    \"member_id\": 1,\n    \"type\": \"borrow\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
					},
					"response": []
				},
				{
					"name": "GET /members/3/transactions",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/members/3/transactions",
							"host": ["{{baseUrl}}"],
							"path": ["members", "3", "transactions"]
						}
					},
					"response": []
				}
			]
		}
	]
