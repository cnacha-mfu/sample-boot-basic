	],
	"item": [
		{
			"name": "1. What a DTO looks like",
			"item": [
				{
					"name": "GET /books/1 - flat, renamed, trimmed",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"",
									"pm.test(\"renamed: the JSON says publish-year, the field is called year\", () => {",
									"    pm.expect(b).to.have.property('publish-year');",
									"    pm.expect(b).to.not.have.property('year');",
									"});",
									"",
									"pm.test(\"flattened: category became two plain fields\", () => {",
									"    pm.expect(b.category_id).to.eql(1);",
									"    pm.expect(b.category_name).to.eql('Programming');",
									"    pm.expect(b.category).to.be.undefined;",
									"});",
									"",
									"pm.test(\"trimmed: the entity's transactions list never travels\", () => {",
									"    pm.expect(b.transactions).to.be.undefined;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/books/1", "host": ["{{baseUrl}}"], "path": ["books", "1"] },
						"description": "Compare with the JPA sample, where this returned a nested \"category\": { ... } object and needed @JsonIgnore to avoid an endless loop.\n\nBookDTO decides all of it. The entity has no Jackson annotations left at all."
					},
					"response": []
				},
				{
					"name": "GET /transactions - two relationships flattened",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const t = pm.response.json()[0];",
									"pm.test(\"book and member each became an id + a label\", () => {",
									"    pm.expect(t).to.have.property('book_id');",
									"    pm.expect(t).to.have.property('book_title');",
									"    pm.expect(t).to.have.property('member_id');",
									"    pm.expect(t).to.have.property('member_name');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] },
						"description": "TransactionMapper flattens BOTH @ManyToOne relationships at once, so a client can print \"Somchai Jaidee borrowed Effective Java\" from a single response."
					},
					"response": []
				},
				{
					"name": "GET /categories - no books array",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"CategoryDTO deliberately has no books field\", () => {",
									"    pm.expect(pm.response.json()[0].books).to.be.undefined;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] },
						"description": "The Category entity HAS a List<Book>. The DTO does not - a client listing categories does not want every book in every one of them.\n\nThis is a design decision, and the DTO is where you get to make it."
					},
					"response": []
				},
				{
					"name": "GET /categories/2/books",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"3 books in Databases\", () => pm.expect(pm.response.json().length).to.eql(3));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/categories/2/books", "host": ["{{baseUrl}}"], "path": ["categories", "2", "books"] }
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Create and read",
			"item": [
				{
					"name": "POST /books - 201",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"const b = pm.response.json();",
									"pm.collectionVariables.set('newBookId', b.id);",
									"pm.test(\"the database assigned an id\", () => pm.expect(b.id).to.be.a('number'));",
									"pm.test(\"the reply is a DTO too, with category_name resolved\", () => {",
									"    pm.expect(b.category_name).to.eql('Programming');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Refactoring\",\n    \"author\": \"Martin Fowler\",\n    \"publish-year\": 2019,\n    \"category_id\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/books", "host": ["{{baseUrl}}"], "path": ["books"] },
						"description": "The body uses the DTO's names: publish-year and category_id, a plain number.\n\nThe controller turns category_id into a real Category row before saving - a job the mapper cannot do, because it needs the database."
					},
					"response": []
				},
				{
