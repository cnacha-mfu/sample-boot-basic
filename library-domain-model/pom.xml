    <artifactId>library-domain-model</artifactId>
    <packaging>jar</packaging>

    <!--
        The DATA SOURCE layer.

        Look at how short this list is. This module knows about JPA and nothing
        else - no web, no JSON, no MapStruct. That is what "loosely coupled"
        means in practice: you could keep these classes and throw the other two
        modules away.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
